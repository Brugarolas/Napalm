function arrays() {
    var a = [];
    System.print([a.length(), a.pop(), a.shift()]);
    System.print([a.push(1), a.push(2), a.push(3)]);
    System.print([a[0], a[2], a[-1], a[3]]);
    a[1] = 20;
    a[5] = 60;
    System.print(a);
    a.setLength(2);
    a.setLength(5);
    System.print(a);
    System.print([a.unshift(9), a.shift(), a.pop(), a.length()]);
    System.print(a);

    var object = { answer: 42 };
    a[0] = object;
    a.push(object);
    a.unshift(object);
    System.print([a[0].answer, a.pop().answer, a.shift().answer]);
    System.print(a[0].answer);
    a.fill(7);
    System.print(a);
    a.fill(object);
    System.print([a[0].answer, a[3].answer]);

    System.print([1, 2, 3].map(|x| x + 1));
    System.print([1, 2, 3, 4].filter(|x| x > 2));
    System.print([1, 2, 3].reduce(|sum, x| sum + x, 0));
}

function strings(text) {
    System.print([text.length, text.startsWith("nap"), text.endsWith("alm")]);
    System.print([text.startsWith(""), text.endsWith(""), text.startsWith("napalm!")]);
    System.print([text.indexOf("a"), text.indexOf("a", 2), text.indexOf("missing")]);
    System.print([text.lastIndexOf("a"), text.lastIndexOf("a", 2), text.indexOf("", 999)]);
    System.print([text.slice(1, 4), text.slice(-3), text.slice(4, 1)]);
    System.print([text.substring(4, 1), text.substring(-10, 3), text.substring(3)]);
}

arrays();
strings("napalm");
System.print([" \tNapalm\n ".trim(), " Napalm ".trimStart(), " Napalm ".trimEnd()]);
System.print(["Napalm!".toUpperCase(), "Napalm!".toLowerCase()]);
System.print(["straße".toUpperCase(), " É ".trim().toLowerCase()]);
var text = "café";
System.print([text.length, text.slice(3), text.substring(0, 3), text.indexOf("é")]);
System.print([null ?? 7, false ?? 7, 0 ?? 7]);
var optional = null;
System.print(optional?.answer);
