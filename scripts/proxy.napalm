System.print("===== Proxy basic traps =====");
var proxyTarget = { foo: 10 };
var proxyLog = Array(0);
proxyLog.setLength(0);

var proxyHandler = {
    get: function (t, key, recv) {
        proxyLog.push("get:" + key);
        return t[key];
    },
    set: function (t, key, value, recv) {
        proxyLog.push("set:" + key);
        t[key] = value;
        return true;
    },
    has: function (t, key) {
        proxyLog.push("has:" + key);
        return key in t;
    },
    deleteProperty: function (t, key) {
        proxyLog.push("del:" + key);
        delete t[key];
        return true;
    },
    ownKeys: function (t) {
        proxyLog.push("ownKeys");
        return t.keys();
    }
};

var proxied = new Proxy(proxyTarget, proxyHandler);
System.print(proxied.foo);                // expect 10, triggers get
proxied.bar = 42;                  // expect set trap, writes through
System.print(proxyTarget.bar);            // expect 42
System.print("foo" in proxied);           // expect true, has trap
delete proxied.foo;                // expect delete trap
System.print("foo" in proxied);           // expect false
System.print(proxied.keys());             // expect ["bar"], uses ownKeys trap
System.print(proxyLog);

System.print("===== Proxy iteration & spread =====");
var proxiedIter = new Proxy({ a: 1, c: 3 }, {
    get: function (t, key, recv) {
        return t[key];
    },
    set: function (t, key, value, recv) {
        t[key] = value;
        return true;
    },
    ownKeys: function (t) {
        return ["c", "a"]; // custom key order
    }
});

System.print(proxiedIter.keys());         // expect ["c", "a"]
System.print(proxiedIter.values());       // expect [3, 1]
System.print(proxiedIter.entries());      // expect [["c",3],["a",1]]
var spreadProxy = { ...proxiedIter, b: 2 };
System.print(spreadProxy.keys());         // expect sorted ["a","b","c"] (object keys sorted alpha)
System.print(spreadProxy.values());       // expect [1,2,3]
