// Napalm syntax tour. Types document intent and are erased before execution.
type Name = string;
interface Point { x: number; y: number; }

const trees: string[] = ['cedar', 'birch', 'oak', 'willow'];
trees.add('maple');
System.print(trees[new Range(1, 3)]); // [birch, oak], exclusive end
System.print(trees[new Range(1, 3, true)]); // [birch, oak, willow]

const name: Name = 'Napalm';
const project = { name, year: 2026, double: (n: number) => n * 2 };
project.year++;
System.print(`${project.name}: ${project.double(21)}`);

let total = 0;
for (let i = 0; i < 10; i++) {
    if (i === 3) continue;
    total += i;
}
for (const tree of trees) System.print(tree);
System.print(total); // 42

function makeCounter(start: number): () => number {
    let value = start;
    return () => ++value;
}
const next = makeCounter(40);
System.print(next());
System.print(next());

class Shape {
    name: string | null;
    constructor(name: string) { this.name = name; }
    describe(): string { return this.name; }
}

class Rectangle extends Shape {
    width: number = 0;
    height: number = 0;
    static created: number = 0;

    constructor(width: number, height: number) {
        super('rectangle');
        this.width = width;
        this.height = height;
        Rectangle.created++;
    }
    get area(): number { return this.width * this.height; }
    set size(value: number) { this.width = value; this.height = value; }
    describe(): string { return `${super.describe()}: ${this.area}`; }
}

const rectangle = new Rectangle(6, 7);
System.print(rectangle.describe());
rectangle.size = 5;
System.print(rectangle.area);
System.print(rectangle instanceof Shape);
System.print(Rectangle.created);

async function answer(): Promise<number> {
    defer { System.print('cleanup'); }
    await Timer.delay(1);
    return 42;
}
System.print(await answer());
const plusOne = async (n: number): Promise<number> => await Promise.resolve(n + 1);
System.print(await plusOne(41));
System.print(await Timer.delay(0, () => 42));

try { throw 'boom'; }
catch (error) { System.print(error); }
finally { System.print('finally'); }

const fiber = new Fiber((first: number) => {
    const resumed = Fiber.yield(first + 1);
    return resumed + 2;
});
System.print(fiber.call(10));
System.print(fiber.call(20));
System.print(fiber.isDone);
