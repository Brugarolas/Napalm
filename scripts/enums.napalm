enum Color {
    Red,
    Green,
    Blue,
}

enum Status {
    Pending = 10,
    Running,
    Failed = -1,
    Done = 20,
}

enum Direction {
    Up = "up",
    Down = "down",
}

function describe(color) {
    if (color == Color.Green) { return "green"; }
    return Color[color];
}

System.print([Color.Red, Color.Green, Color.Blue]);
System.print([Status.Pending, Status.Running, Status.Failed, Status.Done]);
System.print([Direction.Up, Direction.Down]);
System.print([Color[Color.Red], Color[2], Status[-1]]);
System.print(describe(Color.Green));
System.print(describe(Color.Blue));

function local_enum() {
    enum State { Start = 3, Next, End = Next + 5 }
    return function () { return [State.Start, State.Next, State.End]; };
}
var read_state = local_enum();
System.print(read_state());
