// Date demo: JS-compatible Date implemented in Napalm (src/stdlib/date.napalm).
// `Date` is auto-imported from "napalm:date" whenever a module uses it.

// --- Construction ---------------------------------------------------------
let epoch = new Date(0);
print(epoch.toISOString());                        // 1970-01-01T00:00:00.000Z

let t = Date.UTC(2024, 1, 29, 13, 45, 30, 250);    // months are 0-based
let d: Date = new Date(t);
print(d.getTime());                                // 1709214330250
print(d.toISOString());                            // 2024-02-29T13:45:30.250Z
print(d.toUTCString());                            // Thu, 29 Feb 2024 13:45:30 GMT

// Local-time components (output depends on your timezone).
let local = new Date(2024, 0, 31, 9, 30);
print(local.getFullYear() + "-" + (local.getMonth() + 1) + "-" + local.getDate());
print(local.toString());

// Overflowing fields roll over like in JS.
let rolled = new Date(Date.UTC(2023, 13, 35));
print(rolled.toISOString());                       // 2024-03-06T00:00:00.000Z

// --- UTC getters ----------------------------------------------------------
print([d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate(), d.getUTCDay(),
       d.getUTCHours(), d.getUTCMinutes(), d.getUTCSeconds(), d.getUTCMilliseconds()]);

// --- Setters --------------------------------------------------------------
let s = new Date(Date.UTC(2020, 0, 1));
s.setUTCMonth(11, 25);
s.setUTCHours(18, 30);
print(s.toISOString());                            // 2020-12-25T18:30:00.000Z
s.setUTCDate(s.getUTCDate() + 10);                 // crosses the year boundary
print(s.toISOString());                            // 2021-01-04T18:30:00.000Z
s.setTime(86400000);
print(s.toISOString());                            // 1970-01-02T00:00:00.000Z

// --- Static methods -------------------------------------------------------
print(Date.parse("2024-03-05T10:20:30.123Z"));     // 1709634030123
print(Date.parse("2024-03-05"));                   // 1709596800000 (date-only = UTC)
print(Date.parse("2024-03-05T12:20:30+02:00"));    // 1709634030000
print(Date.parse("Tue, 05 Mar 2024 10:20:30 GMT"));// 1709634030000
print(Date.parse(d.toString()) == Date.parse(d.toUTCString()));
let now = Date.now();
print(now > 1700000000000);                        // true

// --- Pre-epoch and extended years -------------------------------------------
let old = new Date(Date.UTC(1969, 11, 31, 23, 59, 59, 999));
print(old.getTime());                              // -1
print(new Date(Date.UTC(-1, 0, 1)).toISOString()); // -000001-01-01T00:00:00.000Z
print(new Date(8640000000000000).toISOString());            // +275760-09-13T00:00:00.000Z

// --- Invalid dates --------------------------------------------------------
let bad = new Date("not a date");
print(bad.getTime());                              // NaN
print(bad.toString());                             // Invalid Date
print(bad.toJSON());                               // null
try {
    bad.toISOString();
} catch (e) {
    print(e);                                      // RangeError: Invalid time value
}

// --- Comparisons / arithmetic go through getTime() --------------------------
let a = new Date(Date.UTC(2024, 0, 1));
let b = new Date(Date.UTC(2024, 11, 31));
print((b.getTime() - a.getTime()) / 86400000);     // 365
print(a.getTime() < b.getTime());                  // true
