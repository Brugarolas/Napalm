let start = System.clock

class JitBench {
  static integratePi(steps: number) {
    let sum: number = 0.0
    let i: number = 0

    while (i < steps) {
      let x: number = (i + 0.5) / steps
      sum = sum + 4.0 / (1.0 + x * x)
      i = i + 1
    }

    return sum / steps
  }

  static xorshift(iterations: number) {
    let x: number = 123456789
    let checksum: number = 0
    let i: number = 0

    while (i < iterations) {
      x = x ^ (x << 13)
      x = x ^ (x >> 17)
      x = x ^ (x << 5)

      x = x & 2147483647

      if ((x & 255) < 32) {
        checksum = checksum + (x & 1023)
      } else {
        checksum = checksum - (x & 31)
      }

      i = i + 1
    }

    return checksum + x
  }

  static mandelbrot(width: number, height: number, maxIter: number) {
    let checksum: number = 0
    let escaped: number = 0
    let y: number = 0

    while (y < height) {
      let ci = (y / height) * 2.0 - 1.0
      let x = 0

      while (x < width) {
        let cr = (x / width) * 3.5 - 2.5

        let zr: number = 0.0
        let zi: number = 0.0
        let zr2: number = 0.0
        let zi2: number = 0.0
        let i: number = 0

        while (i < maxIter && (zr2 + zi2) <= 4.0) {
          zi = 2.0 * zr * zi + ci
          zr = zr2 - zi2 + cr

          zr2 = zr * zr
          zi2 = zi * zi

          i = i + 1
        }

        if (i < maxIter) {
          escaped = escaped + 1
        }

        checksum = checksum + i * (x + 1) * (y + 1)
        x = x + 1
      }

      y = y + 1
    }

    return checksum + escaped
  }
}

let pi = JitBench.integratePi(1000000)
let randomChecksum = JitBench.xorshift(1000000)
let fractalChecksum = JitBench.mandelbrot(800, 600, 1000)

let elapsed = System.clock - start
System.print(`checksums: ${pi}, ${randomChecksum}, ${fractalChecksum}`)
System.print(`elapsed: ${elapsed}`)