// cargo run -- scripts/server.napalm

print("===== HTTP =====");
const server = listen "0.0.0.0:3000" {
  route "GET" ["/", "/hello"] (req) => {
    return { status: 200, body: "Hello!" };
  };

  route "GET" ["/users/:id"] async (req) => {
    await Timer.delay(10);
    return { body: "User " + req.params.id };
  };

  route "GET" ["/sse"] (req) => {
    var hdrs = [ ["Content-Type","text/event-stream; charset=utf-8"], ["Cache-Control", "no-cache"] ];
    http.startStream(req, 200, hdrs);
    var sid = req.serverId; var rid = req.reqId;

    setTimeout(() => { http.streamWrite(sid, rid, "data: tick 1\n\n"); }, 0);
    setTimeout(() => { http.streamWrite(sid, rid, "data: tick 2\n\n"); }, 100);
    setTimeout(() => { http.streamEnd(sid, rid); }, 200);
    return 0; // handled
  };

  route "GET" ["/json"] (req) => {
    return { body: "{\"hello\":\"Napalm\"}", headers: {"Content-Type": "application/json"} };
  };

  route "POST" ["/echo"] (req) => {
    return { status: 200, body: req.body, headers: [ ["X-Echo","1"], ["Content-Type", "application/json"] ] };
  };
}

async function demo() {
  let r1 = await get("http://127.0.0.1:3000/");
  print(r1.status); print(r1.body);

  let r2 = await getJSON("http://127.0.0.1:3000/json");
  print(r2.json.hello);

  let r3 = await postJSON("http://127.0.0.1:3000/echo", "{\"a\":1}", [ ["X-Foo","Bar"] ]);
  print(r3.status); print(r3.json.a);

  let stream = await get("http://127.0.0.1:3000/sse");
  print(stream.body);
  // http.close(server); // Stop accepting connections when you are done.
}

demo();
