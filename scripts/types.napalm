// Optional static typing: annotations are checked before execution, and values
// coming from untyped code are verified by compiled guards at typed boundaries.

// Interfaces and object types describe data only: declaring a method in them is
// a compile error. Behaviour belongs to classes.
interface Shape {
    name: string;
    sides: number;
}

interface Colored {
    color?: string;
}

type Pair<A, B> = { first: A; second: B };

// `implements` adds the contract fields to the class. Required fields (no `?`
// and not nullable) must be initialized by the constructor; optional ones
// start as null.
class Rect implements Shape, Colored {
    width: number;
    height: number;
    constructor(width: number, height: number) {
        this.name = "rect";
        this.sides = 4;
        this.width = width;
        this.height = height;
    }
    function area(): number { return this.width * this.height; }
}

class Square extends Rect {
    constructor(size: number) {
        super(size, size);
        this.name = "square";
    }
}

class Box<T> {
    value: T;
    constructor(value: T) { this.value = value; }
    function read(): T { return this.value; }
    function swap(value: T): T {
        var old = this.value;
        this.value = value;
        return old;
    }
}

function describe(shape: Shape): string {
    return shape.name + "/" + shape.sides;
}

function first<T>(items: T[]): T { return items[0]; }
function pair<A, B>(first: A, second: B): Pair<A, B> { return { first: first, second: second }; }
function label(name: string, suffix?: string): string {
    if (suffix == null) { return name; }
    return name + suffix;
}

var triangle: Shape = { name: "triangle", sides: 3 };
System.print(describe(triangle));               // expect triangle/3

var square = new Square(3);
System.print(square.area());                    // expect 9
System.print(square.color);                     // expect null
System.print(square.keys());                    // expect [width, height, name, sides, color]

// `instanceof` accepts classes, ancestors and implemented interfaces/types;
// `implements` checks contracts and `inherits` checks strict class ancestry.
System.print([square instanceof Square, square instanceof Rect, square instanceof Shape]);
System.print([square implements Colored, square inherits Rect, Rect inherits Rect]);
System.print([triangle instanceof Shape, triangle implements Shape, triangle instanceof Rect]);

var box = new Box<string>("a");
System.print(box.swap("b"));
System.print(box.read());

var p = pair(first([4, 5]), label("napalm", "!"));
System.print([p.first, p.second, label("plain")]);

// Mixing types breaks things: values coming from untyped code are checked at
// typed boundaries, and a violated contract terminates the program (structural
// type errors are deliberately not catchable). For example, both of these would
// stop execution:
//
//   var count: number = fromUntyped();      // "not a number" is not a number
//   System.print(describe({ name: "x" }));  // missing required field `sides`
function fromUntyped() { return "not a number"; }

var raw = fromUntyped() as string;
System.print(raw.length);