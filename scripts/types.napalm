// Optional static typing: annotations are checked before execution, and values
// coming from untyped code are verified by compiled guards at typed boundaries.

interface Shape {
    name: string;
    area(): number;
}

type Pair<A, B> = { first: A; second: B };

class Rect implements Shape {
    name: string;
    width: number;
    height: number;
    constructor(width: number, height: number) {
        this.name = "rect";
        this.width = width;
        this.height = height;
    }
    function area(): number { return this.width * this.height; }
}

class Box<T> {
    value: T;
    constructor(value: T) { this.value = value; }
    function read(): T { return this.value; }
    function swap(value: T): T {
        var old = this.value;
        this.value = value;
        return old;
    }
}

function totalArea(shapes: Shape[]): number {
    var total = 0;
    for (var i = 0; i < shapes.length; i = i + 1) {
        total = total + shapes[i].area();
    }
    return total;
}

function first<T>(items: T[]): T { return items[0]; }
function pair<A, B>(first: A, second: B): Pair<A, B> { return { first: first, second: second }; }
function label(name: string, suffix?: string): string {
    if (suffix == null) { return name; }
    return name + suffix;
}

var square: Shape = { name: "square", area: function() { return 9; } };
var triangle: Shape = { name: "triangle", area: function() { return 6; } };
System.print(totalArea([triangle, square]));   // expect 15
// Runtime interface contracts currently check object (Map) values only, so a
// class instance is used directly rather than through `Shape`.
System.print(new Rect(2, 3).area());            // expect 6

var box = new Box<string>("a");
System.print(box.swap("b"));
System.print(box.read());

var p = pair(first([4, 5]), label("napalm", "!"));
System.print([p.first, p.second, label("plain")]);

// Mixing types breaks things: values coming from untyped code are checked at
// typed boundaries, and a violated contract terminates the program (structural
// type errors are deliberately not catchable). For example, both of these would
// stop execution:
//
//   var count: number = fromUntyped();      // "not a number" is not a number
//   System.print(describe(brokenShape()));  // missing required field `area`
function fromUntyped() { return "not a number"; }

var raw = fromUntyped() as string;
System.print(raw.length);