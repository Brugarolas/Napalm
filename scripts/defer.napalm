function work(fail) {
    var value = 1;
    defer System.print(["last cleanup", value]);
    errdefer System.print("Error detected");
    errdefer (error) System.print(["failure cleanup", error]);
    defer {
        System.print(["first cleanup", value]);
        value = value + 1;
    }

    value = 7;
    if (fail) { throw "work failed"; }
    return value;
}

System.print(work(false));
try { work(true); } catch (error) { System.print(error); }

for (var i = 0; i < 2; i = i + 1) {
    defer System.print(["iteration cleanup", i]);
    System.print(["iteration", i]);
}
