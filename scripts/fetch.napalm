const response = await fetch("https://example.com/api/user");
const user = response.data;

System.print(user.name);

const response = await fetch("https://example.com/api/user", {
    method: "POST",
    headers: {
        "authorization": "Bearer ..."
    },
    body: {
        name: "Andrés",
        active: true
    }
});

const result = response.data;
