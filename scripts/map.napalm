// ===========================
// Map
// ===========================

System.print("===== Map: create, set, get, size =====");
var m = new Map();
m.set("name", "Napalm");
m.set("year", 2024);
m.set(123, "is a number key");

System.print(m.get("name"));       // expect "Napalm"
System.print(m.get("year"));       // expect 2024 (as SMI)
System.print(m.get(123));          // expect "is a number key"
System.print(m.size);              // expect 3
System.print(m.get("missing"));    // expect null

System.print("===== Map: has, delete, clear =====");
System.print(m.has("year"));       // expect true
System.print(m.delete("year"));    // expect true (entry existed)
System.print(m.has("year"));       // expect false
System.print(m.size);              // expect 2
m.clear();
System.print(m.size);              // expect 0

// ===========================
// Set
// ===========================

System.print("===== Set: create, add, has, size =====");
var s = new Set();
s.add("first");
s.add(42);
s.add("first"); // Duplicate, should be ignored

System.print(s.size);              // expect 2
System.print(s.has("first"));      // expect true
System.print(s.has(42));           // expect true
System.print(s.has("second"));     // expect false

System.print("===== Set: delete, clear =====");
System.print(s.delete(42));        // expect true (entry existed)
System.print(s.has(42));           // expect false
System.print(s.size);              // expect 1
s.clear();
System.print(s.size);              // expect 0

// Generic constructors and annotations retain their content types at runtime.
System.print("===== Generic Map and Set =====");
const scores = new Map<string, number>();
scores.set("Napalm", 42);
const names: Set<string> = new Set();
names.add("Napalm").add("Napalm");
System.print(scores.get("Napalm")); // expect 42
System.print(names.size);           // expect 1

const groups = new Map<string, Set<string>>();
groups.set("languages", names);
System.print(groups.get("languages").has("Napalm")); // expect true
System.print([...names]);           // expect [Napalm]
