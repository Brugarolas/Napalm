// Compare with WREN_NO_ENTRY_JIT=1 (loop tier only) and WREN_NO_JIT=1.
class EntryBench {
    static kernel(x): Number {
        let a: Number = x * 1.0001 + 0.25
        let b: Number = a * a - a / 3.0
        let c: Number = b * 0.75 + a * 0.5
        let d: Number = c * c / (b + 1.0)
        return d + b - a + c / 7.0
    }

    static run(count): Number {
        let total: Number = 0
        let i: Number = 0
        while (i < count) {
            total = total + this.kernel(i % 97 + 0.125)
            i = i + 1
        }
        return total
    }
}

EntryBench.run(1000)
let start = System.clock
let checksum = EntryBench.run(1000000)
System.print(`checksum: ${checksum}`)
System.print(`elapsed: ${System.clock - start}`)
