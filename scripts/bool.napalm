System.print("===== Boolean basics =====");
let t = true;
let f = false;
System.print(t);           // expect true
System.print(f);           // expect false
System.print(!t);          // expect false
System.print(!f);          // expect true

System.print("===== Boolean control flow =====");
if (t) {
    System.print("true branch");   // expect "true branch"
}

if (f) {
    System.print("unreachable");
} else {
    System.print("false branch");  // expect "false branch"
}

System.print("===== Boolean equality =====");
System.print(t == f);      // expect false
System.print(t != f);      // expect true
