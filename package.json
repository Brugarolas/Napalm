{
    "name": "napalm-lang",
    "version": "0.1.0",
    "description": "Implementation of Napalm scripting programming language.",
    "main": "index.js",
    "type": "module",
    "scripts": {
        "cargo::run": "cargo run -- scripts/index.napalm",
        "cargo::run::basic": "cargo run > log.txt 2>&1 -- scripts/basic.napalm",
        "cargo::run::builtins": "cargo run > log.txt 2>&1 -- scripts/builtins.napalm",
        "cargo::run::complete": "cargo run > log.txt 2>&1 -- scripts/complete.napalm",
        "cargo::run::comprehensions": "cargo run > log.txt 2>&1 -- scripts/comprehensions.napalm",
        "cargo::run::date": "cargo run > log.txt 2>&1 -- scripts/date.napalm",
        "cargo::run::defer": "cargo run > log.txt 2>&1 -- scripts/defer.napalm",
        "cargo::run::destructure": "cargo run > log.txt 2>&1 -- scripts/destructuring_spread.napalm",
        "cargo::run::enums": "cargo run > log.txt 2>&1 -- scripts/enums.napalm",
        "cargo::run::fetch": "cargo run > log.txt 2>&1 -- scripts/fetch.napalm",
        "cargo::run::import": "cargo run > log.txt 2>&1 -- scripts/import.napalm",
        "cargo::run::interfaces": "cargo run > log.txt 2>&1 -- scripts/interfaces.napalm",
        "cargo::run::intrinsics": "cargo run > log.txt 2>&1 -- scripts/intrinsics.napalm",
        "cargo::run::map": "cargo run > log.txt 2>&1 -- scripts/map.napalm",
        "cargo::run::proxy": "cargo run > log.txt 2>&1 -- scripts/proxy.napalm",
        "cargo::run::reactive": "cargo run > log.txt 2>&1 -- scripts/reactive.napalm",
        "cargo::run::runtime": "cargo run > log.txt 2>&1 -- scripts/runtime.napalm",
        "cargo::run::server_simple": "cargo run > log.txt 2>&1 -- scripts/server_simple.napalm",
        "cargo::run::server_complete": "cargo run > log.txt 2>&1 -- scripts/server.napalm",
        "cargo::run::spread": "cargo run > log.txt 2>&1 -- scripts/spread.napalm",
        "cargo::run::trycatch": "cargo run > log.txt 2>&1 -- scripts/trycatch.napalm",
        "cargo::run::types": "cargo run > log.txt 2>&1 -- scripts/types.napalm",
        "cargo::bench::jit": "cargo run --release -- scripts/jit.napalm",
        "cargo::bench::entries": "cargo run --release -- scripts/jit_entries.napalm",
        "cargo::bench::fib": "cargo run --release -- scripts/fib.napalm",
        "cargo::bench::lev": "cargo run --release -- scripts/lev.napalm",
        "cargo::bench::trees": "cargo run --release -- scripts/trees.napalm",
        "cargo::bench::gc": "cargo run --release -- scripts/gc.napalm",
        "cargo::bench::concurrent": "cargo run --release -- scripts/concurrent.napalm",
        "cargo::build::index": "cargo run --release -- --build scripts/index.napalm",
        "node::bench::fib": "node bench/fib.js",
        "node::bench::trees": "node bench/trees.js",
        "node::bench::lev": "node bench/lev.js",
        "node::bench::jit": "node bench/jit.js",
        "node::bench::entries": "node bench/jit_entries.js",
        "py::bench::fib": "python bench/fib.py",
        "py::bench::trees": "python bench/trees.py",
        "cargo::build": "cargo build --release",
        "test::scripts": "node tools/run-scripts.ts",
        "test::rust": "cargo test --release -- --test-threads=1"
    },
    "engines": {
        "node": ">=22.18"
    },
    "author": "Andrés Brugarolas Martínez",
    "license": "MIT",
    "dependencies": {
        "@vue/reactivity": "^3.5.44"
    }
}