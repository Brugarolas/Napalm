; run: %is_multiple_of_7_i64(0) == 1
; run: %is_multiple_of_7_i64(7) == 1
; run: %is_multiple_of_7_i64(-7) == 1
; run: %is_multiple_of_7_i64(0x1000000000000000) == 0
