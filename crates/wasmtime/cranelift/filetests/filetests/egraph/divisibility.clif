test optimize precise-output
set opt_level=speed
target x86_64

;; The remainder of a division by a constant is not needed when we only want to
;; know whether the dividend is a multiple of that constant.

function %u32_multiple_of_7_eq(i32) -> i8 {
block0(v0: i32):
    v1 = iconst.i32 7
    v2 = urem v0, v1
    v3 = iconst.i32 0
    v4 = icmp eq v2, v3
    return v4
}

