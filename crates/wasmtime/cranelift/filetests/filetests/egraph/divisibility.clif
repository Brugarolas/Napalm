function %u32_multiple_of_7_ne(i32) -> i8 {
block0(v0: i32):
    v1 = iconst.i32 7
    v2 = urem v0, v1
    v3 = iconst.i32 0
    v4 = icmp ne v2, v3
    return v4
}

